      "author": {
        "name": "Anthropic"
      },
      "homepage": "https://github.com/anthropics/claude-plugins-official/tree/main/plugins/hookify",
      "category": "productivity",
      "source": {
        "source": "git-subdir",
        "url": "anthropics/claude-plugins-official",
        "path": "plugins/hookify"
      }
    }
  ]
}
