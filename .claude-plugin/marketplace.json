{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "lamor-plugins",
  "description": "A learning plugin marketplace for Claude Code",
  "owner": {
    "name": "Xellenad",
    "email": "lamor9515@gmail.com",
    "url": "https://github.com/Xellenad"
  },
  "plugins": [
    {
      "name": "hello-toolkit",
      "description": "Example plugin: a skill, a slash command, a subagent and a hook",
      "version": "0.1.0",
      "author": {
        "name": "lamor"
      },
      "category": "learning",
      "source": "./plugins/hello-toolkit"
    },
    {
      "name": "context7",
      "description": "Up-to-date documentation lookup for libraries and frameworks via Context7 MCP",
      "author": {
        "name": "Upstash"
      },
      "homepage": "https://github.com/upstash/context7",
      "category": "documentation",
      "source": {
        "source": "git-subdir",
        "url": "upstash/context7",
        "path": "plugins/claude/context7"
      }
    },
    {
      "name": "typescript-lsp",
      "description": "TypeScript/JavaScript language server for code intelligence",
      "author": {
        "name": "Anthropic"
      },
      "homepage": "https://github.com/anthropics/claude-plugins-official/tree/main/plugins/typescript-lsp",
      "category": "development",
      "source": {
        "source": "git-subdir",
        "url": "anthropics/claude-plugins-official",
        "path": "plugins/typescript-lsp"
      },
      "strict": false,
      "lspServers": {
        "typescript": {
          "command": "typescript-language-server",
          "args": ["--stdio"],
          "extensionToLanguage": {
            ".ts": "typescript",
            ".tsx": "typescriptreact",
            ".js": "javascript",
            ".jsx": "javascriptreact",
            ".mts": "typescript",
            ".cts": "typescript",
            ".mjs": "javascript",
            ".cjs": "javascript"
          }
        }
      }
    }
  ]
}
