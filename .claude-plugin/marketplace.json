{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "lamor-plugins",
  "description": "Curated Claude Code plugins for TypeScript and Angular development: docs lookup, LSP, code review, git workflows, browser debugging and security checks",
  "owner": {
    "name": "Xellenad",
    "email": "lamor9515@gmail.com",
    "url": "https://github.com/Xellenad"
  },
  "plugins": [
    {
      "name": "context7",
      "description": "Up-to-date documentation lookup for libraries and frameworks via Context7 MCP",
      "author": {
        "name": "Upstash"
      },
      "homepage": "https://github.com/upstash/context7",
      "category": "documentation",
      "source": {
        "source": "git-subdir",
        "url": "upstash/context7",
        "path": "plugins/claude/context7"
      }
    },
    {
      "name": "typescript-lsp",
      "description": "TypeScript/JavaScript language server for code intelligence",
      "author": {
        "name": "Anthropic"
      },
      "homepage": "https://github.com/anthropics/claude-plugins-official/tree/main/plugins/typescript-lsp",
      "category": "development",
      "source": {
        "source": "git-subdir",
        "url": "anthropics/claude-plugins-official",
        "path": "plugins/typescript-lsp"
      },
      "strict": false,
      "lspServers": {
        "typescript": {
          "command": "typescript-language-server",
          "args": ["--stdio"],
          "extensionToLanguage": {
            ".ts": "typescript",
            ".tsx": "typescriptreact",
            ".js": "javascript",
            ".jsx": "javascriptreact",
            ".mts": "typescript",
            ".cts": "typescript",
            ".mjs": "javascript",
            ".cjs": "javascript"
          }
        }
      }
    },
    {
      "name": "code-review",
      "description": "Automated code review for pull requests using multiple specialized agents with confidence-based scoring",
      "author": {
        "name": "Anthropic"
      },
      "homepage": "https://github.com/anthropics/claude-plugins-official/tree/main/plugins/code-review",
      "category": "productivity",
      "source": {
        "source": "git-subdir",
        "url": "anthropics/claude-plugins-official",
        "path": "plugins/code-review"
      }
    },
    {
      "name": "commit-commands",
      "description": "Commands for git commit workflows including commit, push, and PR creation",
      "author": {
        "name": "Anthropic"
      },
      "homepage": "https://github.com/anthropics/claude-plugins-official/tree/main/plugins/commit-commands",
      "category": "productivity",
      "source": {
        "source": "git-subdir",
        "url": "anthropics/claude-plugins-official",
        "path": "plugins/commit-commands"
      }
    },
    {
      "name": "chrome-devtools-mcp",
      "description": "Control and inspect a live Chrome browser: performance traces, network requests, console messages and Puppeteer automation",
      "author": {
        "name": "Chrome DevTools Team"
      },
      "homepage": "https://github.com/ChromeDevTools/chrome-devtools-mcp",
      "category": "development",
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    },
    {
      "name": "angular-skills",
      "description": "Official Angular agent skills: code generation, best practices and new app scaffolding",
      "author": {
        "name": "Angular Team"
      },
      "homepage": "https://github.com/angular/skills",
      "category": "development",
      "source": {
        "source": "github",
        "repo": "angular/skills"
      },
      "skills": ["./"]
    },
    {
      "name": "feature-dev",
      "description": "Feature development workflow with agents for codebase exploration, architecture design and quality review",
      "author": {
        "name": "Anthropic"
      },
      "homepage": "https://github.com/anthropics/claude-plugins-official/tree/main/plugins/feature-dev",
      "category": "development",
      "source": {
        "source": "git-subdir",
        "url": "anthropics/claude-plugins-official",
        "path": "plugins/feature-dev"
      }
    },
    {
      "name": "pr-review-toolkit",
      "description": "PR review agents for comments, tests, error handling, type design, code quality and simplification",
      "author": {
        "name": "Anthropic"
      },
      "homepage": "https://github.com/anthropics/claude-plugins-official/tree/main/plugins/pr-review-toolkit",
      "category": "productivity",
      "source": {
        "source": "git-subdir",
        "url": "anthropics/claude-plugins-official",
        "path": "plugins/pr-review-toolkit"
      }
    },
    {
      "name": "modern-web-guidance",
      "description": "Keep your coding agent up to date with the latest web best practices",
      "author": {
        "name": "Google Chrome"
      },
      "homepage": "https://github.com/GoogleChrome/modern-web-guidance",
      "category": "development",
      "source": {
        "source": "github",
        "repo": "GoogleChrome/modern-web-guidance"
      }
    },
    {
      "name": "security-guidance",
      "description": "Security review for Claude-generated code: pattern warnings on edits, diff review on Stop and a commit reviewer",
      "author": {
        "name": "Anthropic"
      },
      "homepage": "https://github.com/anthropics/claude-plugins-official/tree/main/plugins/security-guidance",
      "category": "security",
      "source": {
        "source": "git-subdir",
        "url": "anthropics/claude-plugins-official",
        "path": "plugins/security-guidance"
      }
    },
    {
      "name": "superpowers",
      "description": "Skills for brainstorming, planning, subagent-driven development, systematic debugging and TDD",
      "author": {
        "name": "Jesse Vincent"
      },
      "homepage": "https://github.com/obra/superpowers",
      "category": "development",
      "source": {
        "source": "github",
        "repo": "obra/superpowers"
      }
    },
    {
      "name": "hookify",
